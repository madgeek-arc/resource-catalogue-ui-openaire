{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    // TypeScript 6 turns strict on by default; the strict flags are switched on one by one later instead.
    "strict": false,
    "declaration": false,
    "module": "es2020",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    "useDefineForClassFields": false,
    // The strict flags that are on so far; strictNullChecks and noImplicitAny follow once their errors are fixed.
    "alwaysStrict": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true
  },
  // Shared by the app and spec builds. Template type errors are fixed and this is switched on later.
  "angularCompilerOptions": {
    "strictTemplates": false
  }
}
